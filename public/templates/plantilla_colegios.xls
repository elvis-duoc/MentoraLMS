   <Font ss:FontName="Aptos Narrow" x:Family="Swiss" ss:Size="11"
    ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Colegios">
  <Table ss:ExpandedColumnCount="1" ss:ExpandedRowCount="4" x:FullColumns="1"
   x:FullRows="1" ss:DefaultColumnWidth="62.400000000000006"
   ss:DefaultRowHeight="14.4">
   <Row>
    <Cell><Data ss:Type="String">name</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Colegio1</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Colegio2</Data></Cell>
   </Row>
